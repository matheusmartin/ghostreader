{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plan",
  "description": "Stage S2: the guide's frame, from toc.json. The book's own parts and chapters only, in the book's order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "guide",
    "type",
    "title",
    "parts"
  ],
  "properties": {
    "guide": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The guide id: title and type in lower case with hyphens, \"nexus-summary\""
    },
    "type": {
      "type": "string",
      "enum": [
        "fiction",
        "reading",
        "done"
      ],
      "description": "fiction = Story guide, reading = Reading guide, done = Book summary"
    },
    "title": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "question": {
      "type": "string",
      "description": "Non-fiction: the question the book sets out to answer, in its terms (12 words at most). Fiction: the story's main situation"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Part"
      }
    },
    "skipped": {
      "type": "array",
      "description": "Every toc.json entry of kind body that no chapter uses, with the reason",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "why"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^[0-9]{3}$"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "cast": {
      "type": "array",
      "description": "Fiction: the main people, one role each in the book's words",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "main": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "definitions": {
    "Part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "chapters"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "chapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/Chapter"
          }
        }
      }
    },
    "Chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "title",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Chapter id, as in the Map file: \"ch3\", \"prologue\""
        },
        "number": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{3}$"
          },
          "description": "The chapter's text files, in order"
        },
        "words": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
