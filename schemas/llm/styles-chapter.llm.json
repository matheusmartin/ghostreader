{
  "title": "styles-chapter (LLM profile of schemas/styles.schema.json#/definitions/Chapter)",
  "type": "object",
  "properties": {
    "main": {
      "anyOf": [
        {
          "type": "string",
          "description": "Label of the chapter's main diagram in the Map file (default: its first chart or scenes)"
        },
        {
          "type": "null"
        }
      ]
    },
    "before": {
      "anyOf": [
        {
          "type": "string",
          "description": "Recap's \"Before this chapter\" (50 words at most); leave out in the first chapter"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_items": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "First chapter only, when the file has no top-level \"first_items\": the items of its \"argument so far\" chart (7 words each at most)"
        },
        {
          "type": "null"
        }
      ]
    },
    "part_point": {
      "anyOf": [
        {
          "type": "string",
          "description": "Last written chapter of a part with two or more chapters, when \"parts\" has no point for it: the part's point (7 words at most)"
        },
        {
          "type": "null"
        }
      ]
    },
    "line": {
      "type": "string",
      "description": "Layers' \"In one line\" (20 words at most)"
    },
    "point": {
      "type": "string",
      "description": "The point the chapter adds (7 words at most)"
    },
    "key": {
      "type": "string",
      "description": "The chapter's conclusion (10 words at most)"
    },
    "recap": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "moments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "remember": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "a": {
            "type": "string"
          }
        },
        "required": [
          "q",
          "a"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "main",
    "before",
    "first_items",
    "part_point",
    "line",
    "point",
    "key",
    "recap",
    "moments",
    "remember",
    "questions"
  ],
  "additionalProperties": false
}
