{
  "title": "ledger (LLM profile of schemas/ledger.schema.json)",
  "description": "Stage S4: how one chapter changes the state of the story or the argument. work/<guide>/ledger/<chapter-id>.json",
  "type": "object",
  "properties": {
    "chapter": {
      "type": "string",
      "description": "Chapter id, as in the Map file: \"ch3\", \"prologue\""
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Entry"
      }
    }
  },
  "required": [
    "chapter",
    "entries"
  ],
  "additionalProperties": false,
  "$defs": {
    "Anchor": {
      "type": "object",
      "description": "Where a fact is in the extracted text. Working files only: a guide never shows the quote.",
      "properties": {
        "file": {
          "type": "string",
          "description": "The text file's number in toc.json, three digits: \"005\""
        },
        "p": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "First and last paragraph, the [pN] marks of the text file: [11, 11] or [11, 14]"
        },
        "quote": {
          "type": "string",
          "description": "3 to 12 words copied exactly from the anchored paragraphs, so a script can confirm the anchor"
        }
      },
      "required": [
        "file",
        "p",
        "quote"
      ],
      "additionalProperties": false
    },
    "Entry": {
      "type": "object",
      "description": "Fiction: dimension, entity (not for time and place), after, and before when it was known. Non-fiction: status and text.",
      "properties": {
        "dimension": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "time",
                "place",
                "present",
                "goal",
                "relation",
                "knowledge",
                "possession",
                "view",
                "state"
              ],
              "description": "Fiction: what changes. time and place of the story; present = who is there at the end; goal, relation, knowledge, possession, view, state of a person"
            },
            {
              "type": "null"
            }
          ]
        },
        "entity": {
          "anyOf": [
            {
              "type": "string",
              "description": "Fiction: the person who changes"
            },
            {
              "type": "null"
            }
          ]
        },
        "about": {
          "anyOf": [
            {
              "type": "string",
              "description": "Fiction: the other person or thing, for relation, view, knowledge"
            },
            {
              "type": "null"
            }
          ]
        },
        "before": {
          "description": "Fiction: the state before; null when none was known",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "after": {
          "anyOf": [
            {
              "type": "string",
              "description": "Fiction: the state at the chapter's end"
            },
            {
              "type": "null"
            }
          ]
        },
        "cause": {
          "anyOf": [
            {
              "type": "string",
              "description": "Fiction: why it changed, as the book shows it"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "established",
                "open",
                "answered",
                "promised"
              ],
              "description": "Non-fiction"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "anyOf": [
            {
              "type": "string",
              "description": "Non-fiction: what is established, open, answered or promised"
            },
            {
              "type": "null"
            }
          ]
        },
        "anchor": {
          "$ref": "#/$defs/Anchor"
        }
      },
      "required": [
        "dimension",
        "entity",
        "about",
        "before",
        "after",
        "cause",
        "status",
        "text",
        "anchor"
      ],
      "additionalProperties": false
    }
  }
}
