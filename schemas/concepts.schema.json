{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Concept inventory",
  "description": "Stage S5: every concept and distinction of the book, in book order. check_guide.py concepts builds it from the fact sheets; the writer marks core concepts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "concepts"
  ],
  "properties": {
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "mode",
          "chapter",
          "fact",
          "core"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "concept",
              "typology",
              "contrast",
              "views",
              "fiction"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "explicit",
              "indirect"
            ]
          },
          "chapter": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Chapter id, as in the Map file: \"ch3\", \"prologue\""
          },
          "fact": {
            "type": "string",
            "pattern": "^F[0-9]+$",
            "description": "The concept fact in that chapter's fact sheet"
          },
          "core": {
            "type": "boolean",
            "description": "Later chapters build on it: it always gets a chart in its chapter"
          }
        }
      }
    }
  }
}
