{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claim verdict",
  "description": "Stage S9: an isolated judge's check of one chapter in every style. work/<guide>/verdicts/<chapter-id>.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chapter",
    "claims",
    "must_carry",
    "resume"
  ],
  "properties": {
    "chapter": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Chapter id, as in the Map file: \"ch3\", \"prologue\""
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "style",
          "screen",
          "claim",
          "verdict"
        ],
        "properties": {
          "style": {
            "type": "string",
            "enum": [
              "map",
              "recap",
              "recall",
              "layers"
            ]
          },
          "screen": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*\\.s[0-9]+$",
            "description": "A screen of the guide text: \"ch3.s2\" = chapter ch3, screen 2 (as check_guide.py text and test print them)"
          },
          "claim": {
            "type": "string",
            "description": "One single claim from the screen"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "supported",
              "inferred",
              "unsupported"
            ]
          },
          "anchor": {
            "type": "string",
            "pattern": "^[0-9]{3} p[0-9]+(–p[0-9]+)?$",
            "description": "The paragraph that supports it, or comes closest: \"005 p11\""
          },
          "note": {
            "type": "string",
            "description": "For inferred and unsupported: what the text says instead"
          }
        }
      }
    },
    "must_carry": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "map",
          "recap",
          "recall",
          "layers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^M[0-9]+$"
          },
          "map": {
            "type": "string",
            "description": "The screen that carries it (\"ch3.s2\"), or \"missing\""
          },
          "recap": {
            "type": "string"
          },
          "recall": {
            "type": "string"
          },
          "layers": {
            "type": "string"
          }
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matches_ledger",
        "later_facts",
        "names_without_role"
      ],
      "properties": {
        "matches_ledger": {
          "type": "boolean",
          "description": "\"Where it stands\" and \"Still open\" agree with the ledger at the chapter's end"
        },
        "later_facts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Anything from a later chapter, or a hint of an answer"
        },
        "names_without_role": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names on a text screen without a role at their first mention"
        }
      }
    }
  }
}
