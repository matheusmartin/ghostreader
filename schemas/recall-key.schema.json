{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recall test key",
  "description": "Written by check_guide.py test: the must-carry questions with their answers. Never shown to the reader.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "guide",
    "style",
    "upto",
    "questions"
  ],
  "properties": {
    "guide": {
      "type": "string"
    },
    "style": {
      "type": "string",
      "enum": [
        "map",
        "recap",
        "recall",
        "layers"
      ]
    },
    "upto": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Chapter id, as in the Map file: \"ch3\", \"prologue\""
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "chapter",
          "must",
          "kind",
          "question",
          "answer"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "chapter": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Chapter id, as in the Map file: \"ch3\", \"prologue\""
          },
          "must": {
            "type": "string",
            "pattern": "^M[0-9]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "state",
              "cause",
              "claim",
              "concept",
              "open"
            ]
          },
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        }
      }
    }
  }
}
