{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recall test score",
  "description": "Stage S10: an isolated scorer's marks, from the answers and the key, without the book. work/<guide>/recall-test/<style>-<chapter>-score.json. check_guide.py score adds them up.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scores"
  ],
  "properties": {
    "scores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "score",
          "reason"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "score": {
            "type": "number",
            "enum": [
              1,
              0.5,
              0
            ],
            "description": "1 correct, 0.5 partly correct, 0 wrong or not in the guide"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
