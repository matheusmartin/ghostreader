{
  "name": "ghostreader",
  "private": true,
  "version": "0.3.0",
  "description": "Progressive web app that helps you read a book with charts, infographics and summaries.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build && node scripts/build-pdfs.mjs",
    "build:pdf": "node scripts/build-pdfs.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "check:screens": "node scripts/check-screens.mjs",
    "preview": "vite preview --host",
    "check": "tsc",
    "test": "vitest run",
    "validate": "vitest run tests/books.test.ts",
    "schema": "ts-json-schema-generator --path src/model/types.ts --type Book --out schemas/book.schema.json && node scripts/llm-profile.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "playwright": "1.63.0",
    "ts-json-schema-generator": "2.9.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-window": "7.4.1"
  }
}
